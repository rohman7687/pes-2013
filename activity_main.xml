<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnOpenImg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="Buka .IMG"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnBatchImportBin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Impor Banyak .BIN"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCurrentImg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="start"
        android:singleLine="true"
        android:text="File: Belum ada .img dibuka"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etSearchIndex"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="Cari nomor slot (contoh: 150 atau unnamed_150)..."
        android:inputType="text"
        android:padding="8dp"
        android:textSize="13sp" />

    <ListView
        android:id="@+id/lvArchiveEntries"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="#15888888"
        android:dividerHeight="1dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#20888888"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvSelectedBinInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih salah satu slot di atas untuk pratinjau"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivTexturePreview"
                android:layout_width="130dp"
                android:layout_height="match_parent"
                android:background="#FF222222"
                android:contentDescription="Pratinjau Tekstur"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnReplacePng"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:enabled="false"
                    android:text="Ganti Gambar (PNG)"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnExportPng"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:enabled="false"
                    android:text="Ekspor Gambar ke PNG"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnExportRawBin"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:enabled="false"
                    android:text="Ekspor File .BIN Mentah"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnSaveRebuildImg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#2E7D32"
        android:text="SIMPAN &amp; REBUILD .IMG (0 Perubahan)"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="0" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Siap"
        android:textSize="12sp" />

</LinearLayout>
